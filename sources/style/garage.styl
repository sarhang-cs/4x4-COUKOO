.coukoo-coins
    display none
    position absolute
    z-index 9
    top 18px
    left 18px
    align-items center
    gap 8px
    min-width 86px
    height 38px
    padding 0 12px
    border 1px solid alpha(#fff2c4, 0.42)
    border-radius 999px
    background linear-gradient(135deg, alpha(#2a1b2c, 0.94), alpha(#5a2436, 0.88))
    box-shadow 0 10px 24px alpha(#000000, 0.28), 0 0 0 1px alpha(#ffffff, 0.06) inset
    color #fff2d0
    font-size 14px
    font-weight 900
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-started &
        display flex

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        opacity 0

    &__mark
        display flex
        align-items center
        justify-content center
        width 20px
        height 20px
        border-radius 50%
        background radial-gradient(circle at 30% 30%, #ffe8a2, #ffc864 45%, #f28c22 100%)
        color #4b1b1d
        font-size 11px
        box-shadow 0 0 0 2px alpha(#2e1820, 0.42)

.menu
    .garage-preview
        overflow hidden
        background radial-gradient(circle at 20% 25%, #4a123d, #211824 56%, #0f111c)

        &__grid
            position absolute
            inset -25%
            background-image linear-gradient(alpha(#ffc06a, 0.16) 1px, transparent 1px), linear-gradient(90deg, alpha(#ffc06a, 0.16) 1px, transparent 1px)
            background-size 30px 30px
            transform perspective(450px) rotateX(64deg) translateY(27%)
            transform-origin center bottom

        &__vehicle
            position absolute
            left 17%
            bottom 20%
            width 66%
            height 36%
            filter drop-shadow(0 18px 14px alpha(#000000, 0.35))

        &__body
            position absolute
            left 3%
            bottom 12%
            width 94%
            height 64%
            border 3px solid alpha(#fff6ea, 0.78)
            border-radius 20% 34% 12% 12%
            background linear-gradient(145deg, #efb14f, #cb3d26 45%, #69143c 100%)

            &::before
                content ''
                position absolute
                left 24%
                top -38%
                width 48%
                height 49%
                border 3px solid alpha(#fff6ea, 0.72)
                border-bottom none
                border-radius 22% 22% 0 0
                background linear-gradient(145deg, #9e3061, #331d3d)

        &__wheel
            position absolute
            z-index 1
            bottom 0
            width 25%
            aspect-ratio 1
            border 4px solid #e6e3de
            border-radius 50%
            background radial-gradient(circle, #f3b14c 0 16%, #42213a 18% 40%, #15121d 43% 100%)

            &--front
                right 7%

            &--rear
                left 7%

        &__label
            position absolute
            left 24px
            bottom 20px
            color alpha(#ffffff, 0.85)
            font-family "Amatic SC", sans-serif
            font-size 2rem
            letter-spacing 0.08em

    .garage-content
        .content-inner
            display block

        .garage-header
            display flex
            align-items flex-start
            justify-content space-between
            gap 12px
            margin-bottom 22px

            .title
                margin-bottom 0.1em

        .garage-balance
            display flex
            align-items center
            gap 7px
            min-width max-content
            padding 7px 10px
            border 1px solid alpha(#ffc864, 0.48)
            border-radius 16px
            color #ffd886
            font-size 13px
            font-weight 900

            &__mark
                display flex
                align-items center
                justify-content center
                width 18px
                height 18px
                border-radius 50%
                background #ffc864
                color #4b1b1d
                font-size 11px

        .garage-section
            margin-top 24px

        .garage-section__title
            margin-bottom 10px
            color alpha(#ffffff, 0.92)
            font-size 0.92rem
            font-weight 900
            letter-spacing 0.05em
            text-transform uppercase

.mission-list
    display grid
    gap 10px

.mission-card
    padding 13px
    border 1px solid alpha(#ffffff, 0.2)
    border-radius 10px
    background linear-gradient(135deg, alpha(#ffffff, 0.06), alpha(#ffffff, 0.015))

    &.is-complete
        border-color alpha(#d5ff95, 0.8)
        background linear-gradient(135deg, alpha(#d5ff95, 0.13), alpha(#ffffff, 0.025))

    &__top
        display flex
        align-items flex-start
        justify-content space-between
        gap 12px

    &__title
        margin-bottom 3px
        font-size 0.98rem
        font-weight 900

    &__description
        color alpha(#ffffff, 0.7)
        font-size 0.72rem
        line-height 1.35

    &__reward
        min-width max-content
        color #ffd886
        font-size 0.72rem
        font-weight 900
        white-space nowrap

    &__progress-row
        display flex
        justify-content space-between
        gap 10px
        margin-top 12px
        color alpha(#ffffff, 0.75)
        font-size 0.71rem
        font-weight 700

    &__status
        color #ffd886

    &.is-complete
        .mission-card__status
            color #d5ff95

    &__bar
        height 4px
        margin-top 7px
        overflow hidden
        border-radius 2px
        background alpha(#ffffff, 0.13)

    &__bar-fill
        width 100%
        height 100%
        border-radius inherit
        background linear-gradient(90deg, #f1b44d, #e96853)
        transform-origin 0 50%
        transform scaleX(0)
        transition transform 0.25s ease

    &.is-complete
        .mission-card__bar-fill
            background #d5ff95

.garage-list
    display grid
    gap 10px

.garage-card
    padding 14px
    border 1px solid alpha(#ffffff, 0.2)
    border-radius 10px
    background linear-gradient(135deg, alpha(#ffffff, 0.06), alpha(#ffffff, 0.015))

    &.is-active
        border-color alpha(#ffc864, 0.82)
        box-shadow 0 0 0 1px alpha(#ffc864, 0.12) inset

    &.is-locked
        opacity 0.72

    &__title
        margin-bottom 4px
        color alpha(#ffffff, 0.92)
        font-size 0.98rem
        font-weight 900
        letter-spacing 0.04em

    &__description
        margin-bottom 12px
        color alpha(#ffffff, 0.7)
        font-size 0.72rem
        line-height 1.35

    &__bottom
        display flex
        align-items center
        justify-content space-between
        gap 12px

    &__status
        color #ffd886
        font-size 0.72rem
        font-weight 800

    &.is-owned
        .garage-card__status
            color #d5ff95

    &__button
        min-width 108px
        height 34px
        line-height 32px
        font-size 0.72rem

@media only screen and (max-width 520px)
    .coukoo-coins
        top 76px
        left 12px

    .menu .garage-content .garage-header
        flex-direction column

    .garage-card__bottom
        align-items flex-start
        flex-direction column

    .garage-card__button
        width 100%

.notifications
    .notification
        &.is-mission
        &.is-garage
        &.is-daily-reward
        &.is-controller
        &.is-share
            .top
                display flex
                justify-content space-between
                align-items center
                margin-bottom 5px

                .title
                    margin-bottom 0
                    color #ffd886
                    font-family "Amatic SC", sans-serif
                    font-size 1.65rem
                    line-height 1em

                .progress
                    color #ffd886
                    font-weight 900

            .bottom
                display flex
                justify-content space-between
                align-items flex-start

                .description
                    color #ffffff
                    font-size 14px
                    line-height 1.25

                .open-icon
                    display block
                    width 19px
                    height 19px
                    margin-left 10px
                    background url('/ui/actions/actions-icon-open.webp')
                    background-size 19px 19px

.controller-status
    position absolute
    z-index 9
    top 58px
    right 56px
    display flex
    align-items center
    gap 7px
    max-width 280px
    padding 7px 10px
    border 1px solid alpha(#8fd8ff, 0.62)
    border-radius 16px
    background alpha(#1b2639, 0.9)
    color #d9f3ff
    font-size 12px
    font-weight 900
    opacity 0
    transform translateY(-6px)
    transition opacity 0.2s ease, transform 0.2s ease
    pointer-events none

    &.is-visible
        opacity 1
        transform translateY(0)

.daily-reward
    padding 14px
    border 1px solid alpha(#ffc864, 0.5)
    border-radius 10px
    background linear-gradient(135deg, alpha(#ffc864, 0.17), alpha(#ffffff, 0.025))

    &.is-claimed
        border-color alpha(#d5ff95, 0.48)
        background linear-gradient(135deg, alpha(#d5ff95, 0.1), alpha(#ffffff, 0.02))

    &__top
    &__bottom
        display flex
        align-items center
        justify-content space-between
        gap 12px

    &__top
        align-items flex-start

    &__bottom
        margin-top 13px

    &__title
        display block
        margin-bottom 3px
        color alpha(#ffffff, 0.96)
        font-size 0.98rem
        font-weight 900

    &__status
        color alpha(#ffffff, 0.72)
        font-size 0.72rem
        line-height 1.35

    &__amount
        min-width max-content
        color #ffd886
        font-size 0.8rem
        font-weight 900

    &__streak
        color alpha(#ffffff, 0.75)
        font-size 0.72rem
        font-weight 800

    &__button
        min-width 132px
        height 34px
        line-height 32px
        font-size 0.72rem

    &.is-claimed
        .daily-reward__amount
            color #d5ff95

@media only screen and (max-width 520px)
    .controller-status
        top 112px
        right 54px

    .daily-reward__bottom
        align-items flex-start
        flex-direction column

    .daily-reward__button
        width 100%
