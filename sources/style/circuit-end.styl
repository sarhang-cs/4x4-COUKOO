.circuit-end
    .content
        .your-time
            margin-top 0.5em
            margin-bottom 1em
            text-align center

            .value
                font-size 30px
                font-weight 900

        .or
            padding 12px

        .offline-element
            text-align center

        .not-top-10
            display block
            text-align center

        .input-group
        .or
            display none

    &.is-top-10
        .content
            .not-top-10
                display none

            .input-group
                display flex

            .or
                display block

.circuit-end
    .content
        .circuit-personal-best
            display none
            margin-top -0.25em
            margin-bottom 0.9em
            color #d5ff95
            font-size 0.8rem
            font-weight 800
            text-align center

            &.is-visible
                display block

        .button-share
            display inline-block

    @media only screen and (max-width 520px)
        .content
            .button-share
                width 100%
