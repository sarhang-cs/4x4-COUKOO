.menu .contents .options-content

    .content-inner
        display flex
        flex-direction column
        justify-content flex-start
        align-items center

    table
        width min(100%, 410px)
        border-spacing 0 10px

        td:first-child
            width 42%
            padding-right 22px

        td:last-child
            width 58%

    .audio-toggle
        img
            width 29px
            height 27px

            &.audio-off
                display none

            &.audio-on
                display block

        html.is-audio-muted &
            img
                &.audio-on
                    display none

                &.audio-off
                    display block

    .button
        display flex
        align-items center
        justify-content center
        width 100%
        min-height 34px

    .save-status
        min-width 118px

    .volume-control
        display grid
        grid-template-columns minmax(110px, 1fr) 44px
        gap 10px
        align-items center

        input[type="range"]
            width 100%
            accent-color #f29c38
            cursor pointer

        .volume-value
            font-size 12px
            font-weight 700
            text-align right
            white-space nowrap

    @media (max-width: 480px)
        table
            width 100%
            border-spacing 0 8px

            tbody
                display block

            tr
                display block
                padding 10px 12px
                border 1px solid alpha(#ffffff, 0.12)
                border-radius 12px
                background alpha(#ffffff, 0.03)

            td:first-child
                display block
                width auto
                padding-right 0
                padding-bottom 8px

            td:last-child
                display block
                width auto

        .button
            min-height 42px

        .save-status
            min-width 0

        .volume-control
            grid-template-columns minmax(86px, 1fr) 38px
            gap 7px

    @media (max-width: 380px)
        table
            tr
                padding 9px 10px
