.intro-start-prompt
    position absolute
    z-index 12
    left 50%
    bottom 26px

    @supports (bottom: env(safe-area-inset-bottom))
        bottom unquote('calc(18px + env(safe-area-inset-bottom))')
    display flex
    align-items center
    gap 10px
    width max-content
    max-width calc(100% - 32px)
    padding 12px 18px
    border 1px solid alpha(#ffffff, 0.58)
    border-radius 999px
    background linear-gradient(135deg, alpha(#17121f, 0.82), alpha(#3e1d50, 0.78))
    box-shadow 0 14px 34px alpha(#000000, 0.3), 0 0 0 1px alpha(#b98cff, 0.1) inset
    color #fff8f2
    font-family "Amatic SC", sans-serif
    font-size clamp(28px, 7vw, 44px)
    font-weight 700
    line-height 1
    letter-spacing 0.04em
    text-align center
    text-shadow 0 2px 12px alpha(#000000, 0.45)
    transform translate(-50%, 18px) scale(0.96)
    opacity 0
    pointer-events none
    transition opacity 0.3s ease, transform 0.42s cubic-bezier(0.18, 0.9, 0.25, 1.15)

    &.is-visible
        transform translate(-50%, 0) scale(1)
        opacity 1

    &__arrow
        color #ffd4a0
        font-family sans-serif
        font-size 0.72em
        font-weight 400
        transform rotate(20deg)

    &__label
        white-space nowrap

    @media only screen and (max-width 440px)
        bottom 20px

        @supports (bottom: env(safe-area-inset-bottom))
            bottom unquote('calc(14px + env(safe-area-inset-bottom))')
        gap 8px
        padding 11px 15px

    @media only screen and (max-height 700px)
        bottom 16px

        @supports (bottom: env(safe-area-inset-bottom))
            bottom unquote('calc(12px + env(safe-area-inset-bottom))')
        padding 9px 14px
