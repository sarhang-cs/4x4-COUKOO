.menu .contents .controls-content
    .content-inner
        display flex
        flex-direction column

    .tabs
        display flex
        flex-direction column
        gap 14px

    .tabs-content
        min-height 280px
        transition height 0.2s ease

    .tabs-content-item
        align-items flex-start

    .list
        display flex
        align-items flex-start
        justify-content center
        width 100%
        white-space normal

        table
            width 100%
            max-width 100%
            border-spacing 0 10px

            @media only screen and (max-height 620px)
                border-spacing 0 6px

            @media only screen and (max-height 540px)
                border-spacing 0 2px

        td
            vertical-align top
            line-height 1.4

            &:first-child
                width 45%
                text-align right
                padding-right 15px

            &:last-child
                width 55%

        .key
            display inline-block
            margin 1px 2px
            padding 2px 6px
            border 1px solid #ffffff33
            border-radius 6px
            font-weight 700
            background alpha(#ffffff, 0.04)

        .is-gamepad-button
            display none

            @media only screen and (max-width 520px)
                transform scale(0.8, 0.8)

            @media only screen and (max-width 440px)
                transform scale(0.72, 0.72)

            &.is-playstation
                .is-gamepad-default &
                .is-gamepad-playstation &
                    display inline-block

            &.is-xbox
                .is-gamepad-xbox &
                    display inline-block

            &.is-icon
                background-size cover
                vertical-align middle
                
                &.circle
                    width 15px
                    height 15px
                    background-image url('/ui/controls/gamepad-circle.webp')

                &.triangle
                    width 16px
                    height 15px
                    background-image url('/ui/controls/gamepad-triangle.webp')

                &.square
                    width 15px
                    height 15px
                    background-image url('/ui/controls/gamepad-square.webp')

                &.cross
                    width 14px
                    height 13px
                    background-image url('/ui/controls/gamepad-cross.webp')

    .tutorial-replay-row
        display flex
        justify-content center
        margin-top 18px

    .tutorial-replay
        width min(100%, 280px)

    @media only screen and (max-width 520px)
        .tabs
            gap 12px

        .tabs-content
            min-height 250px

        .list
            font-size 14px

            td
                &:first-child
                    width 46%
                    padding-right 10px

            .key
                padding 2px 5px
                font-size 0.9em

    @media only screen and (max-width 440px)
        .tabs-content
            min-height 230px

        .list
            font-size 13px

            td
                &:first-child
                    width 48%
                    padding-right 8px
